pipeline {
    agent {
        docker {
            image 'node:18-alpine'
            args '-u root'
        }
    }

    parameters {
        string(name: "GIT_BRANCH", defaultValue: "develop", description: "Branch to build")
    }

    environment {
        ANGULAR_DIR = "angular"
    }

    stages {
        stage("Checkout") {
            steps {
                git branch: "${params.GIT_BRANCH}", credentialsId: "ssh-git", url: "git@github.com:TranNguyenPhucAnh/Acme.BookStore.git"
            }
        }

        stage("Install & Build Angular") {
            steps {
                dir("${ANGULAR_DIR}") {
                    sh """
                        corepack enable yarn
                        yarn install
                        yarn build:prod
                        cp dynamic-env.json dist/BookStore/
                        """
                }
            }
        }

        stage("Deploy to S3 & Invalidate Cache") {
            steps {
                script {
                    // 1. Cấu hình biến môi trường AWS (Giả định bạn đã cấu hình Credentials)
                    // Hoặc sử dụng Jenkins AWS Credentials plugin
                    
                    // CÁCH 1: Sử dụng AWS CLI để đồng bộ thư mục build lên S3
                    // Thay thế YOUR_S3_BUCKET_NAME bằng tên Bucket thực tế của bạn
                    // Đồng bộ hóa nội dung thư mục dist lên S3
                    // --delete: Xóa các file trong S3 không còn tồn tại trong thư mục nguồn (để giữ cho bucket sạch)

                    sh """
                        aws s3 sync ${ANGULAR_DIR}/dist/BookStore/ s3://abp-frontend-angular-book-store/ --delete
                    """

                    // 2. Vô hiệu hóa Cache trên CloudFront (quan trọng để người dùng thấy bản mới)
                    // Thay thế YOUR_CLOUDFRONT_DISTRIBUTION_ID
                    // Lệnh này buộc CloudFront phải tải lại toàn bộ nội dung từ S3
                    //sh """
                        // aws cloudfront create-invalidation --distribution-id YOUR_CLOUDFRONT_DISTRIBUTION_ID --paths "/*"
                    //"""
                }
            }
        }

        stage("Archive Build") {
            steps {
                archiveArtifacts artifacts: "${ANGULAR_DIR}/dist/**", fingerprint: true
            }
        }
    }

    post {
        success {
            echo "Build & Deploy succeeded!"
        }
        failure {
            echo "Build failed!"
            emailext (
                subject: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} Failed",
                body: """Build ${env.JOB_NAME} #${env.BUILD_NUMBER} failed.
                    Branch: ${params.GIT_BRANCH}
                    View details: ${env.BUILD_URL}""",
                to: "phucanhatt@gmail.com",
                from: "support@bookstore-demo.online"
            )
        }
    }
}