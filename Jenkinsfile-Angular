pipeline {
    agent any
    environment {
        ANGULAR_DIR = "angular"
        DIST_DIR = "/var/lib/nginx/html"
    }

    stages {
        stage("Checkout") {
            steps {
                git branch: "${params.GIT_BRANCH}", credentialsId: "ssh-git", url: "git@github.com:TranNguyenPhucAnh/Acme.BookStore.git"
            }
        }

        stage("Build Angular") {
            steps {
                dir("${ANGULAR_DIR}") {
                    sh """
                        yarn install
                        yarn build:prod
                    """
                }
            }
        }

        stage("Deploy to Nginx Volume") {
            steps {
                sh """
                    rm -rf ${DIST_DIR}/*
                    cp -r ${ANGULAR_DIR}/dist/BookStore/* ${DIST_DIR}/
                """
            }
        }
    }
}
