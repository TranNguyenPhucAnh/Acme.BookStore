pipeline {
    agent {
        docker {
            image 'bourgeoisie/bookstore-angular:lts'
            args '-u root'
        }
    }

    parameters {
        string(name: "GIT_BRANCH", defaultValue: "develop", description: "Branch to build")
    }

    environment {
        ANGULAR_DIR = "angular"
    }

    stages {
        stage("Checkout") {
            steps {
                git branch: "${params.GIT_BRANCH}", credentialsId: "ssh-git", url: "git@github.com:TranNguyenPhucAnh/Acme.BookStore.git"
            }
        }

        stage("Install & Build Angular") {
            steps {
                dir("${ANGULAR_DIR}") {
                    sh """
                        corepack enable yarn
                        yarn install
                        yarn build:prod
                        cp dynamic-env.json dist/BookStore/
                        """
                }
            }
        }

        stage("Deploy to S3 & Invalidate Cache") {
            steps {
                sh '''
                    echo "Current user: $(whoami)"
                    echo "PATH: $PATH"
                    echo "Which aws: $(which aws || echo 'not in PATH')"
                    echo "LS /usr/local/bin/aws:"
                    ls -l /usr/local/bin/aws || true
                    echo "LS dist/aws:"
                    ls -l /usr/local/aws-cli/v2/dist/aws || true
                    echo "Test binary version:"
                    /usr/local/aws-cli/v2/dist/aws --version || echo "Failed to run binary"
                '''
            }
        }

        stage("Archive Build") {
            steps {
                archiveArtifacts artifacts: "${ANGULAR_DIR}/dist/**", fingerprint: true
            }
        }
    }

    post {
        success {
            echo "Build & Deploy succeeded!"
        }
        failure {
            echo "Build failed!"
            emailext (
                subject: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} Failed",
                body: """Build ${env.JOB_NAME} #${env.BUILD_NUMBER} failed.
                    Branch: ${params.GIT_BRANCH}
                    View details: ${env.BUILD_URL}""",
                to: "phucanhatt@gmail.com",
                from: "support@bookstore-demo.online"
            )
        }
    }
}