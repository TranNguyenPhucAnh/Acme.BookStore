pipeline {
    agent {
        docker {
            image 'mcr.microsoft.com/dotnet/sdk:9.0'
            args '-u root:root'
        }
    }

    parameters {
        string(name: 'GIT_BRANCH', defaultValue: 'develop', description: 'Branch to build')
    }

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = 1
        DOTNET_SKIP_FIRST_TIME_EXPERIENCE = 1
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.GIT_BRANCH}", credentialsId: 'ssh-git', url: 'git@github.com:TranNguyenPhucAnh/Acme.BookStore.git'
            }
        }

        stage('Restore & Build') {
            steps {
                dir('src') {
                    sh 'dotnet restore'
                    sh 'dotnet build Acme.BookStore.sln -c Release'
                }
            }
        }

        stage('Publish') {
            steps {
                dir('src') {
                    sh 'dotnet publish src/Acme.BookStore.HttpApi.Host/Acme.BookStore.HttpApi.Host.csproj -c Release -o ../../publish/api'
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'publish/api/**', fingerprint: true
            }
        }
    }
}