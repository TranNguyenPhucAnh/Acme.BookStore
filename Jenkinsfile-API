pipeline {
    agent any

    parameters {
        string(name: "GIT_BRANCH", defaultValue: "develop", description: "Branch to build")
    }
    
    stages {
        stage("Checkout") {
            steps {
                git branch: "${params.GIT_BRANCH}", credentialsId: "ssh-git", url: "git@github.com:TranNguyenPhucAnh/Acme.BookStore.git"
            }
        }
		
        stage('Setup Signing Certificate') {
            steps {
                withCredentials([certificate(credentialsId: 'signing-certificate', keystoreVariable: 'SIGN_FILE')]) {
                    sh """
                        mkdir -p "${env.WORKSPACE}/certs"
                        chmod 775 "${env.WORKSPACE}/certs"

                        cp "$SIGN_FILE" "${env.WORKSPACE}/certs/sign.pfx"
                        chmod 664 "${env.WORKSPACE}/certs/sign.pfx"
                    """
                }
            }
        }

        stage('Setup Encryption Certificate') {
            steps {
                withCredentials([certificate(credentialsId: 'encryption-certificate', keystoreVariable: 'ENC_FILE')]) {
                    sh """
                        cp "$ENC_FILE" "${env.WORKSPACE}/certs/enc.pfx"
                        chmod 664 "${env.WORKSPACE}/certs/enc.pfx"
                    """
                }
            }
        }

        stage('Build DbMigrator') {
            steps {
                sh """
                    docker build -t acme/bookstore-db-migrator:latest -f src/Acme.BookStore.DbMigrator/Dockerfile.local .
                """
            }
        }

        stage('Run DbMigrator') {
            steps {
                sh """
                    docker run --rm \
                        --network cloudflare-net \
                        -e OpenIddict__Applications__BookStore_App__RootUrl=https://bookstore-demo.online \
                        -e OpenIddict__Applications__BookStore_Swagger__RootUrl=https://bookstore-demo.online/swagger \
                        -e ConnectionStrings__Default="Server=mysql;Port=3306;Database=BookStore;Uid=root;Pwd=root;" \
                        acme/bookstore-db-migrator:latest
                """
            }
        }

        stage('Run Container') {
            steps {
                sh """
                    docker rm -f bookstore-backend || true

                    docker build -t acme-bookstore-httpapi-host:latest -f src/Acme.BookStore.HttpApi.Host/Dockerfile .

                    docker run -d --name bookstore-backend \
                    -p 8080:8080 \
                    -v /var/lib/docker/volumes/jenkins_home/_data/workspace/api/certs:/app/certs \
                    --network cloudflare-net \
                    acme-bookstore-httpapi-host:latest
                """
            }
        }
	}

    post {
        success {
            echo "Build and publish succeeded!"
        }
        failure {
            echo "Build failed!"
			emailext (
					subject: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} Failed",
					body: """Build ${env.JOB_NAME} #${env.BUILD_NUMBER} Failed.
						Branch: ${params.GIT_BRANCH}
						View details: ${env.BUILD_URL}""",
					to: "phucanhatt@gmail.com",
					from: "support@bookstore-demo.online"
				)
        }
    }
}