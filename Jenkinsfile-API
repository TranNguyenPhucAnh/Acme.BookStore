pipeline {
    agent any

    parameters {
        string(name: "GIT_BRANCH", defaultValue: "develop", description: "Branch to build")
        choice(name: "BUILD_CONFIG", choices: ["Release", "Debug"], description: "Build configuration")
    }

    environment {
        DOTNET_CLI_TELEMETRY_OPTOUT = 1
        DOTNET_SKIP_FIRST_TIME_EXPERIENCE = 1
        SOLUTION_FILE = "Acme.BookStore.sln"
        PUBLISH_DIR = "publish/api"
    }

    stages {
        stage("Checkout") {
            steps {
                git branch: "${params.GIT_BRANCH}", credentialsId: "ssh-git", url: "git@github.com:TranNguyenPhucAnh/Acme.BookStore.git"
            }
        }

        stage('Check Jenkins UID') {
            steps {
                sh 'id -u'
            }
        }
		
        stage('Setup Certificate') {
            steps {
                withCredentials([file(credentialsId: 'ssl-certificate', variable: 'PFX_FILE')]) {
                     sh """
                        echo "Creating certs directory in Jenkins container..."
                        mkdir -p "${env.WORKSPACE}/certs"
                        chmod 775 "${env.WORKSPACE}/certs"
                        echo "Copying certificate..."
                        cp "$PFX_FILE" "${env.WORKSPACE}/certs/mynginx.store.pfx"
                        # Try setting ownership, fall back to world-readable if chown fails
                        chown 1654:1654 "${env.WORKSPACE}/certs/mynginx.store.pfx" || chmod 666 "${env.WORKSPACE}/certs/mynginx.store.pfx"
                        chmod 664 "${env.WORKSPACE}/certs/mynginx.store.pfx"

                        echo "Checking file in Jenkins container..."
                        ls -l "${env.WORKSPACE}/certs"
                        stat "${env.WORKSPACE}/certs/mynginx.store.pfx"
                        echo "Jenkins user ID:"
                        id
                    """
                }
            }
        }

        stage("Restore") {
            steps {
                dir("${env.WORKSPACE}") {
                    sh "dotnet restore ${env.SOLUTION_FILE} || exit 1"
                }
            }
        }

        stage("Build") {
            steps {
                dir("${env.WORKSPACE}") {
                    sh "dotnet build ${env.SOLUTION_FILE} -c ${params.BUILD_CONFIG} --no-restore"
                }
            }
        }

        stage("Publish") {
            steps {
                sh "dotnet publish src/Acme.BookStore.HttpApi.Host/Acme.BookStore.HttpApi.Host.csproj -c ${params.BUILD_CONFIG} -o ${env.PUBLISH_DIR}"
            }
        }
		
		stage('Run Container') {
            steps {
                sh """
                    docker rm -f bookstore-backend || true

                    docker build -t acme-bookstore-httpapi-host:latest -f src/Acme.BookStore.HttpApi.Host/Dockerfile .

                    echo WORKSPACE: ${env.WORKSPACE}
                    ls -lh ${env.WORKSPACE}/certs

                    docker run -d --name bookstore-backend -p 8080:8080 -p 8081:8081 \
                    -v "${env.WORKSPACE}/certs/mynginx.store.pfx:/app/mynginx.store.pfx" \
                    acme-bookstore-httpapi-host:latest

                    # Wait for container to start
                    sleep 5

                    # Debug permissions and user
                    echo "Container file permissions:"
                    docker exec bookstore-backend ls -l /app/mynginx.store.pfx
                    docker exec bookstore-backend stat /app/mynginx.store.pfx
                    echo "Container user:"
                    docker exec bookstore-backend whoami
                    docker exec bookstore-backend id
                    echo "Container logs:"
                    docker logs bookstore-backend
                """
            }
        }

        stage("Archive") {
            steps {
                sh "mkdir -p ${env.PUBLISH_DIR}-${BUILD_NUMBER}"
                sh "mv ${env.PUBLISH_DIR}/* ${env.PUBLISH_DIR}-${BUILD_NUMBER}/"
                archiveArtifacts artifacts: "${env.PUBLISH_DIR}-${BUILD_NUMBER}/**", fingerprint: true
            }
        }
	}

    post {
        success {
            echo "Build and publish succeeded!"
        }
        failure {
            echo "Build failed!"
			emailext (
					subject: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} Failed",
					body: """Build ${env.JOB_NAME} #${env.BUILD_NUMBER} Failed.
						Branch: ${params.GIT_BRANCH}
						Config: ${params.BUILD_CONFIG}
						View details: ${env.BUILD_URL}""",
					to: "phucanhatt@gmail.com",
					from: "support@mynginx.store"
				)
        }
    }
}