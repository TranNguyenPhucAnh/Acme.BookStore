FROM jenkins/jenkins:lts

USER root

# Cài Docker CLI, Node.js 18, Yarn (Corepack), và .NET SDK 9.0
RUN mkdir -p /var/jenkins_home/workspace/frontend/angular \
    && chown -R jenkins:jenkins /var/jenkins_home/workspace

# Node.js 18 & Corepack (Yarn)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && corepack enable

# AWS CLI v2
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws

RUN set -eux; \
    \
    # Chuẩn bị SSH known_hosts
    mkdir -p /var/jenkins_home/.ssh && \
    ssh-keyscan github.com > /var/jenkins_home/.ssh/known_hosts && \
    \
    # Cập nhật và cài gói cần thiết
    apt-get update && \
    apt-get install -y --no-install-recommends \
        docker.io \
        openssh-client \
        curl \
        gnupg \
        libicu-dev \
        apt-transport-https \
        software-properties-common && \
    \
    # Dọn dẹp cache apt
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    \
    # Fix quyền cho Jenkins home
    chown -R jenkins:jenkins /var/jenkins_home && \
    \
    # Thêm Jenkins user vào nhóm docker
    usermod -aG docker jenkins

USER jenkins
