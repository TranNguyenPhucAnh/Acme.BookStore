{
    "family": "${TASK_DEF}",
    "containerDefinitions": [
        {
            "cpu": 0,
            "environment": [
                {
                    "name": "ConnectionStrings__Default",
                    "value": "Server=${DB_ENDPOINT};Port=${DB_PORT};Database=BookStore;Uid=${DB_USER};Pwd=${DB_PASSWORD};"
                },
                {
                    "name": "OpenIddict__Applications__BookStore_Swagger__RootUrl",
                    "value": "https://bookstore-demo.online/swagger"
                },
                {
                    "name": "OpenIddict__Applications__BookStore_App__RootUrl",
                    "value": "https://bookstore-demo.online"
                }
            ],
            "environmentFiles": [],
            "essential": true,
            "image": "${IMAGE_URI}",
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/${TASK_DEF}",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-southeast-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "mountPoints": [],
            "name": "db-migrator",
            "portMappings": [],
            "systemControls": [],
            "ulimits": [],
            "volumesFrom": []
        }
    ],
    "taskRoleArn": "${TASK_EXECUTION_ROLE_ARN}",
    "executionRoleArn": "${TASK_EXECUTION_ROLE_ARN}",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}
